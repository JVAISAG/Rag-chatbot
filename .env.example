DATA_DIR=./data
CHROMA_PATH=./chroma_db
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_TIMEOUT=300
OLLAMA_CONTEXT_TOKENS=2048
OLLAMA_BATCH_SIZE=128
OLLAMA_KEEP_ALIVE=15m
# Container-side host RAM prompt cache; zero disables retention of old prompts.
WORKSPACE_OLLAMA_CACHE_RAM_MB=0
# Optional, only after verifying GPU capacity for this model; leave unset for CPU/auto.
# OLLAMA_GPU_LAYERS=99
BACKEND_URL=http://127.0.0.1:8000/api/v1
REQUEST_TIMEOUT=360

# Set a local database password before starting the workspace database.
# WORKSPACE_DB_PASSWORD=
# Set false explicitly for local HTTP; the application default is true.
WORKSPACE_COOKIE_SECURE=false
TOKENIZERS_PARALLELISM=false
RAYON_NUM_THREADS=1
OMP_NUM_THREADS=2
